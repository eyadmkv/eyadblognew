---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection(
  'blog',
  ({ data }) => data.status === 'published'
)).sort((a, b) => b.data.date.localeCompare(a.data.date));

const formatDate = (date: string) =>
  new Date(`${date}T00:00:00Z`).toLocaleDateString('ar-EG', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  });

const featuredPost = posts[0];
---

<BaseLayout>
  <div class="page-shell">
    <section class="hero" aria-labelledby="home-title">
      <div class="hero-copy">
        <span class="eyebrow">ملاحظات في الإنسان والحياة</span>
        <h1 id="home-title">أكتب كي أرى<br /><span>الأشياء على مهل.</span></h1>
        <p>
          أنا إياد محمد حلمي. هذه مساحة للأفكار التي لا تستعجل إجاباتها؛
          عن الإنسان، والتقنية، وتفاصيل الحياة التي تمرّ بنا كل يوم.
        </p>
        <a class="hero-link" href="#archive">اقرأ من الأرشيف <span aria-hidden="true">←</span></a>
      </div>
    </section>

    {featuredPost && (
      <a class="featured-post" href={`/post/${featuredPost.data.id}`}>
        <span class="featured-label">أحدث مقال</span>
        <span class="featured-content">
          <span class="featured-kicker">أحدث ما كُتب · {formatDate(featuredPost.data.date)}</span>
          <span class="featured-title">{featuredPost.data.titleAr || featuredPost.data.titleEn}</span>
          {featuredPost.data.excerptAr && <span class="featured-excerpt">{featuredPost.data.excerptAr}</span>}
        </span>
      </a>
    )}

    <section id="archive" aria-labelledby="archive-title">
      <div class="archive-heading">
        <div>
          <span class="archive-kicker">كل ما كُتب هنا</span>
          <h2 id="archive-title">الأرشيف</h2>
        </div>
        <span class="archive-count">{posts.length} نصًّا</span>
      </div>

      <div class="post-list">
        {posts.map((post) => (
          <a class="post-card" href={`/post/${post.data.id}`}>
            <div class="post-body">
            <div class="post-meta">
              <time datetime={post.data.date}>
                {formatDate(post.data.date)}
              </time>
              <span aria-hidden="true">·</span>
              <span class="post-category">{post.data.category}</span>
            </div>

            <h3>{post.data.titleAr || post.data.titleEn}</h3>

            {post.data.excerptAr && (
              <p>{post.data.excerptAr}</p>
            )}

            <div class="tag-list">
              {post.data.tags.slice(0, 4).map((tag) => (
                <span class="tag">{tag.replaceAll('_', ' ')}</span>
              ))}
            </div>
            </div>
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
