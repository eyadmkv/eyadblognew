---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection(
  'blog',
  ({ data }) => data.status === 'published'
)).sort((a, b) => b.data.date.localeCompare(a.data.date));

const toDate = (date: string) => new Date(`${date}T00:00:00Z`);
const arNum = (n: number) => n.toLocaleString('ar-EG');
const formatFull = (date: string) =>
  toDate(date).toLocaleDateString('ar-EG', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const formatDay = (date: string) =>
  toDate(date).toLocaleDateString('ar-EG', { day: 'numeric', timeZone: 'UTC' });
const formatMonthYear = (date: string) =>
  toDate(date).toLocaleDateString('ar-EG', { month: 'long', year: 'numeric', timeZone: 'UTC' });

const readingTime = (n: number) => {
  if (n === 1) return 'دقيقة واحدة';
  if (n === 2) return 'دقيقتان';
  return n <= 10 ? `${arNum(n)} دقائق` : `${arNum(n)} دقيقة`;
};

const featuredPost = posts[0];

const categoryCounts = new Map<string, number>();
for (const post of posts) {
  categoryCounts.set(post.data.category, (categoryCounts.get(post.data.category) ?? 0) + 1);
}
const categories = [...categoryCounts.entries()].sort(
  (a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'ar')
);
---

<BaseLayout>
  <div class="container">
    <script is:inline>
      try {
        if (sessionStorage.getItem('hero-played')) document.documentElement.classList.add('hero-seen');
        else sessionStorage.setItem('hero-played', '1');
      } catch (e) {}
    </script>
    <section class="hero" aria-labelledby="home-title">
      <h1 id="home-title">
        <span class="hero-line">أكتب كي أرى</span>
        <span class="hero-line hero-line--soft">الأشياء على مهل<span class="hero-stop">.</span></span>
      </h1>
      <div class="hero-side">
        <p class="hero-lede">
          أنا إياد محمد حلمي. هذه مساحة للأفكار التي لا تستعجل إجاباتها؛
          عن الإنسان، والتقنية، وتفاصيل الحياة التي تمرّ بنا كل يوم.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="#archive">اقرأ من الأرشيف <span class="arrow" aria-hidden="true">←</span></a>
          <a class="btn btn-ghost" href="/about">من أنا؟</a>
        </div>
      </div>
    </section>

    {featuredPost && (
      <a class="featured" href={`/post/${featuredPost.data.id}`}>
        <div class="featured-top">
          <span class="featured-badge">{featuredPost.data.locked ? 'أحدث مقال · محمي بكلمة مرور' : 'أحدث مقال'}</span>
          <time datetime={featuredPost.data.date}>{formatFull(featuredPost.data.date)}</time>
          <span aria-hidden="true">·</span>
          <span>{featuredPost.data.category}</span>
        </div>
        <h2>{featuredPost.data.titleAr || featuredPost.data.titleEn}</h2>
        {featuredPost.data.excerptAr && <p class="featured-excerpt">{featuredPost.data.excerptAr}</p>}
        <span class="featured-cta">اقرأ المقال <span class="arrow" aria-hidden="true">←</span></span>
      </a>
    )}

    <section class="archive" id="archive" aria-labelledby="archive-title">
      <div class="section-head">
        <div>
          <h2 id="archive-title">الأرشيف</h2>
        </div>
        <span class="archive-count">النصوص: <b data-count>{arNum(posts.length)}</b></span>
      </div>

      {categories.length > 1 && (
        <div class="filters" role="group" aria-label="تصفية حسب التصنيف" data-filters hidden>
          <button class="chip" type="button" data-filter="all" aria-pressed="true">
            الكل <span class="chip-count">{arNum(posts.length)}</span>
          </button>
          {categories.map(([name, count]) => (
            <button class="chip" type="button" data-filter={name} aria-pressed="false">
              {name} <span class="chip-count">{arNum(count)}</span>
            </button>
          ))}
        </div>
      )}
      <p class="visually-hidden" role="status" aria-live="polite" data-status></p>

      <div class="post-list">
        {posts.map((post, index) => (
          <a class="post-row" href={`/post/${post.data.id}`} data-category={post.data.category} style={`--dim:${(index / Math.max(posts.length - 1, 1)).toFixed(2)}`}>
            <time class="row-date" datetime={post.data.date}>
              <span class="row-day">{formatDay(post.data.date)}</span>
              <span class="row-month">{formatMonthYear(post.data.date)}</span>
            </time>

            <div class="row-main">
              <div class="row-kicker">
                <span class="row-category">{post.data.category}</span>
                <span>{readingTime(post.data.readingTimeMin)} للقراءة</span>
                {post.data.locked && (
                  <span class="badge-lock">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <rect x="4" y="11" width="16" height="10" rx="2" />
                      <path d="M8 11V7a4 4 0 0 1 8 0v4" />
                    </svg>
                    محمي بكلمة مرور
                  </span>
                )}
              </div>

              <h3>{post.data.titleAr || post.data.titleEn}</h3>

              {post.data.excerptAr && <p class="row-excerpt">{post.data.excerptAr}</p>}

              {post.data.tags.length > 0 && (
                <ul class="tag-list" aria-label="الوسوم">
                  {post.data.tags.slice(0, 4).map((tag) => (
                    <li class="tag">{tag.replaceAll('_', ' ')}</li>
                  ))}
                </ul>
              )}
            </div>

            <span class="row-arrow arrow" aria-hidden="true">←</span>
          </a>
        ))}
      </div>
    </section>
  </div>

  <script>
    const group = document.querySelector<HTMLElement>('[data-filters]');
    const chips = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const rows = document.querySelectorAll<HTMLElement>('[data-category]');
    const count = document.querySelector<HTMLElement>('[data-count]');
    const status = document.querySelector<HTMLElement>('[data-status]');

    if (group && chips.length) {
      group.hidden = false;

      chips.forEach((chip) => {
        chip.addEventListener('click', () => {
          const selected = chip.dataset.filter ?? 'all';
          let visible = 0;

          rows.forEach((row) => {
            const show = selected === 'all' || row.dataset.category === selected;
            row.hidden = !show;
            if (show) visible += 1;
          });

          chips.forEach((other) => other.setAttribute('aria-pressed', String(other === chip)));

          const shown = visible.toLocaleString('ar-EG');
          if (count) count.textContent = shown;
          if (status) {
            status.textContent =
              selected === 'all' ? `عرض كل النصوص: ${shown}` : `عرض ${shown} من تصنيف ${selected}`;
          }
        });
      });
    }
  </script>
</BaseLayout>
