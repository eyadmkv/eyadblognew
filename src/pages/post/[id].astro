---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { createCipheriv, pbkdf2Sync, randomBytes } from 'node:crypto';

const keyDerivationIterations = 310_000;

export async function getStaticPaths() {
  const posts = (await getCollection(
    'blog',
    ({ data }) => data.status === 'published'
  )).sort((a, b) => b.data.date.localeCompare(a.data.date));

  const toLink = (entry?: (typeof posts)[number]) =>
    entry
      ? { id: entry.data.id, title: entry.data.titleAr || entry.data.titleEn, locked: entry.data.locked }
      : null;

  return posts.map((post, index) => ({
    params: { id: post.data.id },
    props: {
      post,
      newer: toLink(posts[index - 1]),
      older: toLink(posts[index + 1]),
    },
  }));
}

const { post, newer, older } = Astro.props;
const locked = post.data.locked;
let Content;
let encryptedPayload: string | undefined;

if (locked) {
  const passwordVariable = post.data.passwordEnv!;
  const password = process.env[passwordVariable];
  if (!password) {
    throw new Error(`Set ${passwordVariable} in the build environment to encrypt post ${post.data.id}.`);
  }

  const salt = randomBytes(16);
  const iv = randomBytes(12);
  const key = pbkdf2Sync(password, salt, keyDerivationIterations, 32, 'sha256');
  const cipher = createCipheriv('aes-256-gcm', key, iv);
  const ciphertext = Buffer.concat([cipher.update(post.body, 'utf8'), cipher.final(), cipher.getAuthTag()]);

  encryptedPayload = JSON.stringify({
    version: 1,
    iterations: keyDerivationIterations,
    salt: salt.toString('base64'),
    iv: iv.toString('base64'),
    ciphertext: ciphertext.toString('base64'),
  }).replace(/</g, '\\u003c');
} else {
  ({ Content } = await render(post));
}

const title = post.data.titleAr || post.data.titleEn;
const description = post.data.excerptAr || post.data.excerptEn || title;
const canonical = new URL(
  `/post/${post.data.id}`,
  Astro.site ?? Astro.url
).href;
const publishedDate = new Date(`${post.data.date}T00:00:00Z`).toISOString();
const modifiedDate = new Date(post.data.updatedAt ?? post.data.date).toISOString();
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  datePublished: publishedDate,
  dateModified: modifiedDate,
  author: { '@type': 'Person', name: 'إياد محمد حلمي', alternateName: 'إياد محمد جاويش' },
  publisher: { '@type': 'Person', name: 'إياد محمد حلمي', alternateName: 'إياد محمد جاويش' },
  image: new URL('/icon-512.png', Astro.site ?? Astro.url).href,
  inLanguage: 'ar',
};

const formattedDate = new Date(
  `${post.data.date}T00:00:00Z`
).toLocaleDateString('ar-EG', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});

const minutes = post.data.readingTimeMin;
const minutesLabel = (() => {
  if (minutes === 1) return 'دقيقة واحدة';
  if (minutes === 2) return 'دقيقتان';
  const n = minutes.toLocaleString('ar-EG');
  return minutes <= 10 ? `${n} دقائق` : `${n} دقيقة`;
})();
---

<BaseLayout
  title={`${title} | إياد اللامع`}
  description={description}
  canonical={canonical}
  type="article"
  publishedTime={publishedDate}
  modifiedTime={modifiedDate}
  structuredData={locked ? null : structuredData}
  robots={locked ? 'noindex, nofollow, noarchive' : 'index, follow'}
>
  <div class="read-progress" aria-hidden="true"><span data-progress></span></div>

  <article class="reader" data-article>
    <a class="back-link" href="/"><span class="arrow" aria-hidden="true">←</span> العودة إلى الأرشيف</a>

    <header class="reader-header">
      <div class="reader-kicker">
        <span class="reader-category">{post.data.category}</span>
        <time datetime={post.data.date}>{formattedDate}</time>
        <!--<span aria-hidden="true">·</span> -->
      <!--<span>{minutesLabel} للقراءة</span> -->       
      </div>

      <h1>{title}</h1>

      {post.data.excerptAr && (
        <p class="reader-excerpt">{post.data.excerptAr}</p>
      )}
    </header>

    {locked ? (
      <section class="locked-post" data-locked-post>
        <form class="locked-form" data-unlock-form>
          <div class="locked-intro">
            <span class="locked-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="4" y="11" width="16" height="10" rx="2" />
                <path d="M8 11V7a4 4 0 0 1 8 0v4" />
              </svg>
            </span>
            <div>
              <strong>هذا المقال محمي بكلمة مرور</strong>
              <span>أدخل كلمة المرور ليُفتح النص هنا في متصفحك.</span>
            </div>
          </div>
          <label for="post-password">كلمة مرور المقال</label>
          <div class="locked-form-row">
            <input id="post-password" name="password" type="password" autocomplete="current-password" aria-describedby="post-password-status" required />
            <button type="submit">فتح المقال</button>
          </div>
          <p class="locked-status" id="post-password-status" data-unlock-status role="status" aria-live="polite"></p>
        </form>
        <script type="application/json" data-locked-payload set:html={encryptedPayload} />
        <section class="prose locked-content" data-unlocked-content dir="rtl" hidden>
          <h2 tabindex="-1" data-unlocked-heading>نص المقال</h2>
          <div data-unlocked-body></div>
        </section>
        <script>
          import '../../scripts/unlock-post.ts';
        </script>
      </section>
    ) : (
      <div class="prose" dir="rtl">
        <Content />
      </div>
    )}

    <footer class="reader-footer">
      {post.data.tags.length > 0 && (
        <ul class="tag-list" aria-label="الوسوم">
          {post.data.tags.map((tag) => (
            <li class="tag">{tag.replaceAll('_', ' ')}</li>
          ))}
        </ul>
      )}

      <p class="reader-byline">
        <span>بقلم <strong>إياد محمد حلمي</strong></span>
      </p>

      {(older || newer) && (
        <nav class="post-nav" aria-label="مقالات أخرى">
          {older && (
            <a class="is-older" href={`/post/${older.id}`} rel="prev">
              <span class="post-nav-label">→ الأقدم</span>
              <span class="post-nav-title">{older.title}</span>
            </a>
          )}
          {newer && (
            <a class="is-newer" href={`/post/${newer.id}`} rel="next">
              <span class="post-nav-label">الأحدث ←</span>
              <span class="post-nav-title">{newer.title}</span>
            </a>
          )}
        </nav>
      )}
    </footer>
  </article>

  <script>
    const bar = document.querySelector<HTMLElement>('[data-progress]');
    const article = document.querySelector<HTMLElement>('[data-article]');

    if (bar && article) {
      let queued = false;

      const update = () => {
        queued = false;
        const rect = article.getBoundingClientRect();
        const scrollable = rect.height - window.innerHeight;
        const progress = scrollable > 0 ? Math.min(1, Math.max(0, -rect.top / scrollable)) : 1;
        bar.style.transform = `scaleX(${progress})`;
      };

      const request = () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(update);
      };

      window.addEventListener('scroll', request, { passive: true });
      window.addEventListener('resize', request);
      update();
    }
  </script>
</BaseLayout>
