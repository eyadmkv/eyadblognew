---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection(
    'blog',
    ({ data }) => data.status === 'published'
  );

  return posts.map((post) => ({
    params: { id: post.data.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const title = post.data.titleAr || post.data.titleEn;
const description = post.data.excerptAr || post.data.excerptEn || title;
const canonical = new URL(
  `/post/${post.data.id}`,
  Astro.site ?? Astro.url
).href;
const publishedDate = new Date(`${post.data.date}T00:00:00Z`).toISOString();
const modifiedDate = new Date(post.data.updatedAt ?? post.data.date).toISOString();
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  datePublished: publishedDate,
  dateModified: modifiedDate,
  author: { '@type': 'Person', name: 'إياد محمد حلمي', alternateName: 'إياد محمد جاويش' },
  publisher: { '@type': 'Person', name: 'إياد محمد حلمي', alternateName: 'إياد محمد جاويش' },
  image: new URL('/icon-512.png', Astro.site ?? Astro.url).href,
  inLanguage: 'ar',
};

const formattedDate = new Date(
  `${post.data.date}T00:00:00Z`
).toLocaleDateString('ar-EG', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<BaseLayout
  title={`${title} | إياد اللامع`}
  description={description}
  canonical={canonical}
  type="article"
  publishedTime={publishedDate}
  modifiedTime={modifiedDate}
  structuredData={structuredData}
>
  <article class="reader">
    <a class="back-link" href="/">العودة إلى الأرشيف ←</a>

    <header class="reader-header">
      <div class="post-meta">
        <time datetime={post.data.date}>{formattedDate}</time>
        <span aria-hidden="true">·</span>
        <span>{post.data.readingTimeMin} دقائق للقراءة</span>
      </div>

      <h1>{title}</h1>

      {post.data.excerptAr && (
        <p class="reader-excerpt">{post.data.excerptAr}</p>
      )}
    </header>

    <div class="prose" dir="rtl">
      <Content />
    </div>

    <div class="reader-tags">
      {post.data.tags.map((tag) => (
        <span class="tag">{tag.replaceAll('_', ' ')}</span>
      ))}
    </div>

    <p class="post-meta" style="margin-top: 40px;">
      بقلم إياد محمد حلمي
    </p>
  </article>
</BaseLayout>
